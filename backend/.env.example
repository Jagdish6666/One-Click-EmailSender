# ==============================================
# ONE-CLICK-EMAILSENDER — Backend Environment Example
# Copy this file to .env and fill in real values
# ==============================================

# Database — MySQL
DATABASE_URL=jdbc:mysql://localhost:3306/cert_sender_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USER=
DATABASE_PASSWORD=

# JWT — Used by auth-service (signing) and api-gateway (validation)
# Generate a Base64-encoded secret of at least 256 bits
# Example: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
